# ── One Zero Credentials ───────────────────────────────────────────────────────
# Your One Zero login email
ONE_ZERO_EMAIL=your@email.com

# Your One Zero login password
ONE_ZERO_PASSWORD=yourpassword

# ── Two-Factor Authentication (choose one) ─────────────────────────────────────
#
# Option A (recommended after first run):
#   Paste the OTP_LONG_TERM_TOKEN printed after your first successful login.
#   This lets you skip SMS verification on every subsequent run.
#
ONE_ZERO_OTP_LONG_TERM_TOKEN=

#
# Option B (first-time / when you don't have a long-term token yet):
#   Provide your phone number in international format (e.g. +972501234567).
#   The script will trigger an SMS and ask you to type the code interactively.
#
ONE_ZERO_PHONE_NUMBER=+972501234567

# ── Who Spent More (optional) ──────────────────────────────────────────────────
#
# If this is a joint account, set the names of both account holders.
# Any transaction description containing this name will be attributed to that person.
# Leave blank to skip the "Who Spent More" section.
#
PERSON1_NAME=
PERSON2_NAME=
